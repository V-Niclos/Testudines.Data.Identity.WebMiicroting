@page "/"
<PageTitle>@pageTitle</PageTitle>
@using IdetityNet10MySql.Data.Seeders;
<PageTitle>Contador</PageTitle>

<h1>@pageTitle</h1>

<b> List users and role for testing</b>
<p> All test user has  @SeederUserRoles.Test_Password as password</p>

<b> Roles:</b>
<ul>
@for (int i = 0; i < SeederUserRoles.Test_RolesList.Length; i++)
{
        <li>@SeederUserRoles.Test_RolesList[i]</li>
}
</ul>

<b>Users and his roles </b>
<ul>
@foreach (var user in SeederUserRoles.Test_UsersList)
    {
        <li>  @user.userNameEmail, Roles:
            @if ( user.userRole !=null)
            {
                <span>@string.Join(", ", user.userRole)</span>
            }
        </li>
    }
</ul>
@code {
    
    string pageTitle = "Home test page IdetityNet10MySql";


}